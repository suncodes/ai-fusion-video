# ============================================
# 融光 - 环境变量配置
# ============================================
# 复制此文件为 .env 并修改配置:
#   cp .env.example .env
# ============================================

# ---------- 对外端口 ----------
APP_PORT=8080

# ---------- 预构建镜像 ----------
REGISTRY=ghcr.nju.edu.cn
IMAGE_NAMESPACE=suncodes
IMAGE_TAG=latest

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=ai_fusion_video

# ---------- Redis ----------
REDIS_PASSWORD=123456

# ---------- 后端 JVM ----------
JAVA_OPTS=-Xms512m -Xmx1024m
